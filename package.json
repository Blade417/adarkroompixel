{
  "name": "emberveil-pixel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Emberveil (余烬之境) — a pixel-art edition of A Dark Room. Original gameplay and story, new presentation.",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-release.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
